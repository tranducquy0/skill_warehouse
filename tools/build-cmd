#!/usr/bin/env bash
set -euo pipefail
IFS=$'\n\t'

# build-cmd: generate agent-specific command files from JSON definitions
#
# Usage:
#   tools/build-cmd <cmd.json> --hermes   # writes to ~/.hermes/plugins/
#   tools/build-cmd <cmd.json> --opencode # writes to .opencode/commands/
#   tools/build-cmd <cmd.json> --pi       # writes to .pi/commands/
#   tools/build-cmd <cmd.json> --codex    # writes to .codex/commands/

# -- helpers

die() {
    printf '%s\n' "$1" >&2
    exit 1
}

usage() {
    cat <<'EOF'
usage: tools/build-cmd <cmd.json> --hermes|--opencode|--pi|--codex

reads a JSON command definition and writes an agent-specific command file.

JSON format (cmds/<name>.json):
  {
    "name": "command-name",
    "desc": "short description",
    "prompt": "full prompt text"
  }
EOF
}

# -- parse args

if [ $# -lt 2 ]; then
    usage
    exit 2
fi

json_file="$1"
agent_flag="$2"

# Resolve agent type
case "$agent_flag" in
    --hermes)   agent="hermes" ;;
    --opencode) agent="opencode" ;;
    --pi)       agent="pi" ;;
    --codex)    agent="codex" ;;
    *) die "unknown agent flag: $agent_flag (expected --hermes, --opencode, --pi, or --codex)" ;;
esac

[ -f "$json_file" ] || die "file not found: $json_file"

# -- parse JSON (no jq dependency; minimal parser for name/desc/prompt)

# Extract a string field from JSON using sed, then unescape via printf %b
extract_json_str() {
    local key="$1"
    local raw
    raw=$(sed -n "s/.*\"${key}\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$json_file")
    printf '%b' "$raw"
}

cmd_name=$(extract_json_str "name")
cmd_desc=$(extract_json_str "desc")
cmd_prompt=$(extract_json_str "prompt")

[ -n "$cmd_name" ] || die "JSON missing required 'name' field"
[ -n "$cmd_desc" ] || die "JSON missing required 'desc' field"
[ -n "$cmd_prompt" ] || die "JSON missing required 'prompt' field"

# -- resolve output directory

PROJECT_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

case "$agent" in
    hermes)
        out_dir="$HOME/.hermes/plugins"
        ;;
    opencode)
        out_dir="$PROJECT_ROOT/.opencode/commands"
        ;;
    pi)
        out_dir="$PROJECT_ROOT/.pi/commands"
        ;;
    codex)
        out_dir="$PROJECT_ROOT/.codex/commands"
        ;;
esac

mkdir -p "$out_dir"

# -- generate command file per agent

case "$agent" in
    hermes)
        # Hermes plugin: executable bash script that prints the prompt
        # Uses a quoted heredoc delimiter to preserve prompt content verbatim
        # Supports {{var}} template substitution via environment variables at runtime

        # Write the static header
        cat > "$out_dir/${cmd_name}.sh" <<'SCRIPT_HEADER'
#!/usr/bin/env bash
set -euo pipefail
# Generated by tools/build-cmd
# This plugin outputs a prompt for the agent to follow.
# Supports {{var}} template substitution via environment variables.
SCRIPT_HEADER

        # Append description and source
        printf '# %s\n' "$cmd_desc" >> "$out_dir/${cmd_name}.sh"
        printf '# Source JSON: %s\n' "$json_file" >> "$out_dir/${cmd_name}.sh"
        printf '\n' >> "$out_dir/${cmd_name}.sh"

        # Write the prompt using a quoted heredoc (no shell expansion of content)
        # Delimiter is unique to avoid collision with prompt content
        local_heredoc_delim="PROMPT_EOF_${cmd_name//-/}_$$"
        printf 'PROMPT=$(cat <<'"'"'%s'"'"'\n' "$local_heredoc_delim" >> "$out_dir/${cmd_name}.sh"
        printf '%s\n' "$cmd_prompt" >> "$out_dir/${cmd_name}.sh"
        printf '%s\n' "$local_heredoc_delim" >> "$out_dir/${cmd_name}.sh"
        printf ')\n' >> "$out_dir/${cmd_name}.sh"
        printf '\n' >> "$out_dir/${cmd_name}.sh"

        # Write the substitution + print logic
        cat >> "$out_dir/${cmd_name}.sh" <<'SCRIPT_BODY'
# Substitute {{var}} placeholders with matching env vars
output="$PROMPT"
while [[ "$output" == *"{{"* ]]; do
    var=$(printf '%s' "$output" | sed -n 's/.*{{\([a-zA-Z_]*\)}}.*/\1/p')
    [ -z "$var" ] && break
    val="${!var:-}"
    output="${output//\{\{$var\}\}/$val}"
done

# Print the prompt for the agent
printf '%s\n' "$output"
SCRIPT_BODY
        chmod +x "$out_dir/${cmd_name}.sh"
        ;;
    opencode)
        cat > "$out_dir/${cmd_name}.md" <<EOF
---
description: ${cmd_desc}
---

${cmd_prompt}
EOF
        ;;
    pi)
        cat > "$out_dir/${cmd_name}.md" <<EOF
---
description: ${cmd_desc}
---

${cmd_prompt}
EOF
        ;;
    codex)
        cat > "$out_dir/${cmd_name}.md" <<EOF
---
description: ${cmd_desc}
---

${cmd_prompt}
EOF
        ;;
esac

printf '%s\n' "generated: $out_dir/${cmd_name}"
